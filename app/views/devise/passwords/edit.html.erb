<% content_for :title, "Redefinir senha — Paracetacaro" %>

<div class="row justify-content-center mt-5">
  <div class="col-sm-8 col-md-5 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h4 class="card-title text-center mb-4">Redefinir senha</h4>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <div class="mb-3">
            <%= f.label :password, "Nova senha", class: "form-label" %>
            <% if @minimum_password_length %>
              <div class="form-text">Mínimo <%= @minimum_password_length %> caracteres</div>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
          </div>

          <%= f.submit "Salvar nova senha", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
