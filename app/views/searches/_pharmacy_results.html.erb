<div id="pharmacy_<%= config.slug %>_results" class="card">
  <div class="card-body">
    <h5 class="card-title"><%= config.name %></h5>

    <% if results.empty? %>
      <p class="text-muted mb-0">Nenhum resultado encontrado.</p>
    <% else %>
      <div class="d-flex align-items-center gap-1" data-controller="carousel">
        <button class="btn btn-outline-secondary btn-sm flex-shrink-0" data-action="click->carousel#prev">
          <i class="bi bi-chevron-left"></i>
        </button>
        <div class="carousel-scroll flex-grow-1" data-carousel-target="scroll">
        <% results.each do |result| %>
          <div class="product-card card">
            <% if result.imagem.present? %>
              <img src="<%= result.imagem %>" alt="<%= result.nome %>" class="card-img-top p-2">
            <% end %>
            <div class="card-body p-2 d-flex flex-column">
              <p class="product-name mb-1"><%= result.nome %></p>
              <% if result.fabricante.present? %>
                <small class="text-muted"><%= result.fabricante %></small>
              <% end %>
              <% if result.vendedor.present? %>
                <span class="badge mt-1" style="background-color: #b8860b; font-size: 0.65rem;">
                  <i class="bi bi-shop"></i> <%= result.vendedor %>
                </span>
              <% end %>
              <div class="mt-auto pt-2">
                <% if result.promocao.present? %>
                  <span class="badge bg-danger mb-1 text-wrap d-block"><%= result.promocao %></span>
                <% end %>
                <div class="fw-bold preco">
                  <%= number_to_currency(result.preco, unit: "R$", separator: ",", delimiter: ".") %>
                </div>
                <% if result.preco_original.present? && result.preco_original > result.preco %>
                  <small class="text-muted">
                    <s><%= number_to_currency(result.preco_original, unit: "R$", separator: ",", delimiter: ".") %></s>
                  </small>
                <% end %>
                <%= link_to "Ver produto", result.url, target: "_blank", rel: "noopener noreferrer", class: "btn btn-outline-primary btn-sm w-100 mt-2" %>
                <%= button_to cart_selections_path,
                  params: {
                    query: query,
                    pharmacy_slug: config.slug,
                    pharmacy_name: config.name,
                    nome: result.nome,
                    preco: result.preco,
                    url: result.url,
                    imagem: result.imagem,
                    fabricante: result.fabricante,
                    preco_original: result.preco_original,
                    sku_id: result.sku_id,
                    promocao: result.promocao
                  },
                  class: "btn btn-success btn-sm w-100 mt-1" do %>
                  <i class="bi bi-cart3"></i> Adicionar
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
        </div>
        <button class="btn btn-outline-secondary btn-sm flex-shrink-0" data-action="click->carousel#next">
          <i class="bi bi-chevron-right"></i>
        </button>
      </div>
    <% end %>
  </div>
</div>
